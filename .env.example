# PostgreSQL
POSTGRES_USER=chrono
POSTGRES_PASSWORD=chrono_secret
POSTGRES_DB=chrono
DATABASE_URL=postgresql://chrono:chrono_secret@localhost:5432/chrono

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Pon REDIS_ENABLED=false si no tienes Redis (CRUD funciona, notificaciones no)
REDIS_ENABLED=true

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# API
API_PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
MOBILE_DEEP_LINK=chrono://auth
WEB_APP_URL=http://localhost:8081

# Email (notificaciones web)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Chrono <noreply@chrono.app>
